# Casa de Lautaro: la vivienda y sus tres plantas.

casa tiene_planta planta_baja.
casa tiene_planta planta_primera.
casa tiene_planta planta_segunda.

planta_baja esta_en casa.
planta_primera esta_en casa.
planta_segunda esta_en casa.

# La primera está encima de la baja, y la segunda encima de la primera.
planta_primera encima_de planta_baja.
planta_segunda encima_de planta_primera.

# --- Habitaciones de la planta baja ---
salon_bajo esta_en_planta planta_baja.
estudio esta_en_planta planta_baja.
buhardilla esta_en_planta planta_baja.
sala_juegos esta_en_planta planta_baja.
habitacion_invitados esta_en_planta planta_baja.

# --- Habitaciones de la planta primera ---
cocina esta_en_planta planta_primera.
salon esta_en_planta planta_primera.
bano_primera esta_en_planta planta_primera.
sala_tv esta_en_planta planta_primera.

# --- Habitaciones de la planta segunda (zona de dormir) ---
dormitorio_lautaro esta_en_planta planta_segunda.
dormitorio_paola esta_en_planta planta_segunda.
dormitorio_caterina esta_en_planta planta_segunda.
bano_paola esta_en_planta planta_segunda.
bano_compartido esta_en_planta planta_segunda.

# Los dormitorios de Lautaro y de Paola tienen balcón.
dormitorio_lautaro tiene_balcon balcon_lautaro.
balcon_lautaro esta_en dormitorio_lautaro.
dormitorio_paola tiene_balcon balcon_paola.
balcon_paola esta_en dormitorio_paola.

# El baño de Paola es privado; el otro lo comparten Lautaro y Caterina.
bano_paola privado_de paola.
bano_compartido compartido_por lautaro.
bano_compartido compartido_por caterina.

# --- Exterior: patios ---
casa tiene_patio patio_delantero.
casa tiene_patio patio_trasero.
patio_delantero esta_en casa.
patio_trasero esta_en casa.

# En el patio trasero hay una barbacoa y una canasta de básket.
barbacoa esta_en patio_trasero.
canasta esta_en patio_trasero.
